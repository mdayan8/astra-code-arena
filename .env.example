# Copy to .env and adjust. Never commit the real .env. Comments must be on their own lines.
APP_HOST=0.0.0.0
# Which of the server's IP addresses to publish on (0.0.0.0 = all). Set a specific LAN IP to serve only on that network.
APP_BIND=0.0.0.0
# The port agreed with the college IT team
APP_PORT=8000
APP_ENV=production
APP_TIMEZONE=Asia/Kolkata
# Private admin route (no leading slash). Leave empty to auto-generate one on first start;
# `python -m app.manage info` (or `docker compose exec web python -m app.manage info`) prints it.
ADMIN_PATH=
# Set true ONLY when the site is served over HTTPS. Over plain http:// on the LAN keep false.
COOKIE_SECURE=false
SESSION_HOURS=12
MAX_UPLOAD_MB=20
# Campus-network lock: only these address ranges can open the platform (comma-separated CIDRs). Empty = no lock.
# Ask IT for the lab and Wi-Fi subnets, e.g. ALLOWED_NETWORKS=10.20.0.0/16,172.16.40.0/22
ALLOWED_NETWORKS=
# Judge processes: about the number of CPU cores you can spare (4-8 for 200-300 students)
JUDGE_WORKERS=4
BACKUP_KEEP=14
# Optional AI assistant: any OpenAI-compatible endpoint. Local Ollama on the same server:
#   with Docker:    AI_BASE_URL=http://host.docker.internal:11434/v1
#   without Docker: AI_BASE_URL=http://127.0.0.1:11434/v1
#   AI_MODEL=qwen2.5-coder:7b
AI_BASE_URL=
AI_MODEL=
AI_API_KEY=
AI_TIMEOUT=180
# Simultaneous AI calls (keeps RAM/CPU low)
AI_CONCURRENCY=2
